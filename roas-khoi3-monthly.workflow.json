      "position": [1280, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Notion-Version", "value": "2022-06-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ parent: { database_id: $('Cấu hình').item.json.ROAS_DB }, properties: { 'Tháng': { title: [ { text: { content: $('Tổng hợp + ROAS').item.json.label } } ] }, 'Kỳ': { date: { start: $('Tổng hợp + ROAS').item.json.since, end: $('Tổng hợp + ROAS').item.json.monthEnd } }, 'Chi ads DrSkin': { number: $('Tổng hợp + ROAS').item.json.spend }, 'DT khóa học': { number: $('Tổng hợp + ROAS').item.json.dt }, 'Lead': { number: $('Tổng hợp + ROAS').item.json.leads }, 'Nguồn': { select: { name: 'Meta + Excel sync' } }, 'Ghi chú': { rich_text: [ { text: { content: $('Tổng hợp + ROAS').item.json.ghichu } } ] } } }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-00000000000b",
      "name": "Notion — Tạo row mới",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 420]
    }
  ],
