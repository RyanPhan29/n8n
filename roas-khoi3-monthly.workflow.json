        "jsonBody": "={{ JSON.stringify({ properties: { 'Chi ads DrSkin': { number: $('Tổng hợp + ROAS').item.json.spend }, 'DT khóa học': { number: $('Tổng hợp + ROAS').item.json.dt }, 'Lead': { number: $('Tổng hợp + ROAS').item.json.leads }, 'Nguồn': { select: { name: 'Meta + Excel sync' } }, 'Ghi chú': { rich_text: [ { text: { content: $('Tổng hợp + ROAS').item.json.ghichu } } ] } } }) }}",
        "options": {}
      },
