# === Credential cho POC tự động hoá (khai trong n8n: Settings → Variables, và GitHub Secrets) ===

# Claude (viết kịch bản trong n8n + viết Spec trong GitHub Action)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Vbee AI Voice — LẤY TRONG DASHBOARD VBEE (mục API). Sửa node Vbee cho khớp doc gói của anh.
VBEE_APP_ID=xxxxxxxx
VBEE_TOKEN=xxxxxxxx
VBEE_VOICE_CODE=hn_male_xxxxx      # mã giọng NAM BẮC anh đang dùng

# GitHub (commit mp3 + kích Action render). Token scope: repo + workflow
GITHUB_TOKEN=ghp_xxxxxxxx

# Telegram (2 cửa duyệt) — tạo bot ở @BotFather
TELEGRAM_BOT_TOKEN=123456:ABCxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Webhook n8n để GitHub Action gọi về báo render xong (Cửa 2)
# Lấy từ node "⏸ Chờ render xong" trong n8n (Production URL)
N8N_RENDER_CALLBACK=https://n8n.anh.com/webhook/render-done
