Dialogue: 0,0:00:00.00,0:00:02.08,Sub,,0,0,0,,Có dự án\Nmời bạn góp vốn
Dialogue: 0,0:00:02.08,0:00:04.40,Sub,,0,0,0,,cam kết lợi nhuận\Nmười tám phần trăm một năm
Dialogue: 0,0:00:04.40,0:00:05.58,Sub,,0,0,0,,Nghe sướng tai đúng không?
Dialogue: 0,0:00:05.58,0:00:06.77,Sub,,0,0,0,,Khoan đã
Dialogue: 0,0:00:06.77,0:00:07.95,Sub,,0,0,0,,Thử nghĩ ngược lại
Dialogue: 0,0:00:07.95,0:00:09.99,Sub,,0,0,0,,Ngân hàng cho vay còn\Ncó mười mấy phần trăm
Dialogue: 0,0:00:09.99,0:00:11.35,Sub,,0,0,0,,gửi tiết kiệm chỉ sáu
Dialogue: 0,0:00:11.35,0:00:12.40,Sub,,0,0,0,,bảy phần trăm
Dialogue: 0,0:00:12.40,0:00:16.15,Sub,,0,0,0,,Vậy một dự án lấy đâu\Nra lợi nhuận mười tám phần trăm
Dialogue: 0,0:00:16.15,0:00:17.51,Sub,,0,0,0,,đều đặn để chia cho bạn
Dialogue: 0,0:00:17.51,0:00:19.85,Sub,,0,0,0,,trong khi chính họ đang\Nphải đi vay để tồn tại?
Dialogue: 0,0:00:19.85,0:00:22.63,Sub,,0,0,0,,Câu trả lời thường là họ\Nlấy tiền của người vào sau
Dialogue: 0,0:00:22.63,0:00:24.07,Sub,,0,0,0,,trả cho người vào trước
Dialogue: 0,0:00:24.07,0:00:25.20,Sub,,0,0,0,,Cam kết lợi nhuận càng cao
Dialogue: 0,0:00:25.20,0:00:26.43,Sub,,0,0,0,,rủi ro càng lớn
Dialogue: 0,0:00:26.43,0:00:27.77,Sub,,0,0,0,,chứ không phải càng hời
Dialogue: 0,0:00:27.77,0:00:29.24,Sub,,0,0,0,,Khi dòng người mới ngừng lại
Dialogue: 0,0:00:29.24,0:00:31.39,Sub,,0,0,0,,cũng là lúc\Ndự án đắp chiếu
Dialogue: 0,0:00:31.39,0:00:33.15,Sub,,0,0,0,,và tiền của bạn\Nkẹt luôn trong đó
Dialogue: 0,0:00:33.15,0:00:34.11,Sub,,0,0,0,,Thấy cam kết lợi\Nnhuận cao chót vót
Dialogue: 0,0:00:34.11,0:00:35.11,Sub,,0,0,0,,bạn nên mừng, hay nên chạy?
Dialogue: 0,0:00:35.11,0:00:36.41,Sub,,0,0,0,,Comment cho Anh Hai biết