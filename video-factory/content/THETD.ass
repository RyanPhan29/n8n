Dialogue: 0,0:00:00.00,0:00:01.71,Sub,,0,0,0,,Có hai tấm thẻ\Nnhìn giống hệt nhau
Dialogue: 0,0:00:01.71,0:00:03.05,Sub,,0,0,0,,cùng nằm gọn trong ví bạn
Dialogue: 0,0:00:03.05,0:00:04.51,Sub,,0,0,0,,Một tấm là thẻ ghi nợ
Dialogue: 0,0:00:04.51,0:00:05.83,Sub,,0,0,0,,tiêu bằng chính tiền của bạn
Dialogue: 0,0:00:05.83,0:00:07.32,Sub,,0,0,0,,Tấm kia là thẻ tín dụng
Dialogue: 0,0:00:07.32,0:00:08.85,Sub,,0,0,0,,tiêu bằng tiền\Nngân hàng cho mượn
Dialogue: 0,0:00:08.85,0:00:10.82,Sub,,0,0,0,,Vậy mà chỉ một tấm thẻ\Ntín dụng thôi đã làm cả
Dialogue: 0,0:00:10.82,0:00:12.79,Sub,,0,0,0,,cõi mạng chia làm hai phe
Dialogue: 0,0:00:12.79,0:00:14.25,Sub,,0,0,0,,Có người khoe dùng ba năm
Dialogue: 0,0:00:14.25,0:00:15.19,Sub,,0,0,0,,hạn mức một tỷ
Dialogue: 0,0:00:15.19,0:00:16.06,Sub,,0,0,0,,tiện vô cùng
Dialogue: 0,0:00:16.06,0:00:17.78,Sub,,0,0,0,,Lại có người bảo\Nđó là cái bẫy
Dialogue: 0,0:00:17.78,0:00:19.52,Sub,,0,0,0,,vướng vào là nửa\Nđêm ngủ không yên
Dialogue: 0,0:00:19.52,0:00:20.37,Sub,,0,0,0,,ăn không ngon
Dialogue: 0,0:00:20.37,0:00:23.05,Sub,,0,0,0,,Rốt cuộc, thẻ tín dụng\Nlà đòn bẩy của người giàu
Dialogue: 0,0:00:23.05,0:00:24.66,Sub,,0,0,0,,hay cái bẫy\Nnợ của người nghèo?
Dialogue: 0,0:00:24.66,0:00:26.31,Sub,,0,0,0,,Hôm nay Anh Hai\Nbóc cho bạn nghe
Dialogue: 0,0:00:26.31,0:00:27.39,Sub,,0,0,0,,bằng con số thật
Dialogue: 0,0:00:27.39,0:00:30.11,Sub,,0,0,0,,Trước hết, phải hiểu vì sao\Ndân sành tiền lại mê thẻ
Dialogue: 0,0:00:30.11,0:00:31.33,Sub,,0,0,0,,tín dụng đến vậy
Dialogue: 0,0:00:31.33,0:00:33.85,Sub,,0,0,0,,Bí mật lớn nhất nằm\Nở ba chữ miễn lãi
Dialogue: 0,0:00:33.85,0:00:35.39,Sub,,0,0,0,,Thẻ tín dụng\Ncho bạn tiêu trước
Dialogue: 0,0:00:35.39,0:00:37.84,Sub,,0,0,0,,rồi được tới bốn mươi lăm\Nngày không mất một đồng lãi
Dialogue: 0,0:00:37.84,0:00:40.56,Sub,,0,0,0,,Con số bốn mươi lăm này\Nlà ba mươi ngày của một
Dialogue: 0,0:00:40.56,0:00:41.46,Sub,,0,0,0,,chu kỳ sao kê
Dialogue: 0,0:00:41.46,0:00:44.26,Sub,,0,0,0,,cộng thêm mười lăm ngày ân\Nhạn để bạn xoay tiền trả
Dialogue: 0,0:00:44.26,0:00:45.11,Sub,,0,0,0,,Nghĩa là gì?
Dialogue: 0,0:00:45.11,0:00:46.31,Sub,,0,0,0,,Nghĩa là bạn cứ tiêu\Nbằng tiền của ngân hàng
Dialogue: 0,0:00:46.31,0:00:49.03,Sub,,0,0,0,,còn tiền của mình thì để\Nyên trong tài khoản tiết kiệm
Dialogue: 0,0:00:49.03,0:00:50.58,Sub,,0,0,0,,cho nó sinh lãi\Nthêm gần một tháng rưỡi
Dialogue: 0,0:00:50.58,0:00:53.86,Sub,,0,0,0,,Người giàu gọi đó là dùng tiền\Nngười khác để làm việc cho mình
Dialogue: 0,0:00:53.86,0:00:55.20,Sub,,0,0,0,,Cho dễ hình dung nhé
Dialogue: 0,0:00:55.20,0:00:57.69,Sub,,0,0,0,,Bạn quẹt hai mươi triệu\Ntiền mua sắm vào đầu kỳ
Dialogue: 0,0:00:57.69,0:00:59.29,Sub,,0,0,0,,Suốt gần một\Ntháng rưỡi sau đó
Dialogue: 0,0:00:59.29,0:01:00.63,Sub,,0,0,0,,bạn không mất một đồng lãi
Dialogue: 0,0:01:00.63,0:01:03.51,Sub,,0,0,0,,còn hai mươi triệu tiền mặt\Ncủa mình thì vẫn nằm trong
Dialogue: 0,0:01:03.51,0:01:05.53,Sub,,0,0,0,,sổ tiết kiệm, đều\Nđặn sinh lời cho bạn
Dialogue: 0,0:01:05.53,0:01:07.72,Sub,,0,0,0,,Đến hạn, bạn trả\Nđủ hai mươi triệu
Dialogue: 0,0:01:07.72,0:01:10.87,Sub,,0,0,0,,coi như xong, mà lại được\Nxài chùa dòng vốn của ngân
Dialogue: 0,0:01:10.87,0:01:12.81,Sub,,0,0,0,,hàng gần một\Ntháng rưỡi Chưa hết
Dialogue: 0,0:01:12.81,0:01:13.71,Sub,,0,0,0,,Mỗi lần quẹt thẻ
Dialogue: 0,0:01:13.71,0:01:16.93,Sub,,0,0,0,,nhiều loại thẻ còn hoàn\Nlại cho bạn một phần tiền
Dialogue: 0,0:01:16.93,0:01:18.28,Sub,,0,0,0,,hoặc tích điểm đổi ưu đãi
Dialogue: 0,0:01:18.28,0:01:21.14,Sub,,0,0,0,,Và đây mới là phần ít\Nngười để ý nhưng lại giá
Dialogue: 0,0:01:21.14,0:01:23.17,Sub,,0,0,0,,trị nhất: mỗi lần\Nbạn trả nợ đúng hạn
Dialogue: 0,0:01:23.17,0:01:26.58,Sub,,0,0,0,,bạn đang âm thầm xây cho\Nmình một hồ sơ đẹp trên
Dialogue: 0,0:01:26.58,0:01:29.07,Sub,,0,0,0,,hệ thống C.I.C, tức là trung\Ntâm thông tin tín dụng quốc
Dialogue: 0,0:01:29.07,0:01:32.47,Sub,,0,0,0,,gia, nơi mọi ngân hàng đều\Ntra trước khi cho ai vay tiền
Dialogue: 0,0:01:32.47,0:01:34.49,Sub,,0,0,0,,Cái lịch sử\Ntrả nợ đẹp đó
Dialogue: 0,0:01:34.49,0:01:35.93,Sub,,0,0,0,,sau này khi bạn\Ncần vay mua nhà
Dialogue: 0,0:01:35.93,0:01:37.22,Sub,,0,0,0,,mua xe, chính là\Ntấm giấy thông hành
Dialogue: 0,0:01:37.22,0:01:38.57,Sub,,0,0,0,,ngân hàng gật đầu nhanh hơn
Dialogue: 0,0:01:38.57,0:01:40.66,Sub,,0,0,0,,duyệt khoản vay lớn hơn
Dialogue: 0,0:01:40.66,0:01:43.33,Sub,,0,0,0,,và cho bạn mức lãi tốt\Nhơn hẳn một người chưa từng
Dialogue: 0,0:01:43.33,0:01:44.74,Sub,,0,0,0,,có lịch sử tín dụng
Dialogue: 0,0:01:44.74,0:01:45.77,Sub,,0,0,0,,Với một người kỷ luật
Dialogue: 0,0:01:45.77,0:01:49.37,Sub,,0,0,0,,tấm thẻ tín dụng đúng là\Nmột đòn bẩy gần như miễn phí
Dialogue: 0,0:01:49.37,0:01:52.95,Sub,,0,0,0,,Nhưng khoan đã, đây mới là\Nmặt bên kia của đồng xu
Dialogue: 0,0:01:52.95,0:01:54.53,Sub,,0,0,0,,và là chỗ hầu\Nhết mọi người ngã ngựa
Dialogue: 0,0:01:54.53,0:01:57.25,Sub,,0,0,0,,Tất cả những ưu đãi ngọt\Nngào kia chỉ đúng khi bạn
Dialogue: 0,0:01:57.25,0:01:59.29,Sub,,0,0,0,,trả toàn bộ dư nợ
Dialogue: 0,0:01:59.29,0:02:00.61,Sub,,0,0,0,,đúng hạn, không thiếu một đồng
Dialogue: 0,0:02:00.61,0:02:02.51,Sub,,0,0,0,,Chỉ cần bạn trả thiếu
Dialogue: 0,0:02:02.51,0:02:04.46,Sub,,0,0,0,,hoặc trễ một ngày
Dialogue: 0,0:02:04.46,0:02:07.31,Sub,,0,0,0,,cái ưu đãi miễn lãi\Nbiến mất ngay lập tức
Dialogue: 0,0:02:07.31,0:02:10.19,Sub,,0,0,0,,và ngân hàng bắt đầu tính lãi từ\Nhai mươi đến bốn mươi phần trăm một năm
Dialogue: 0,0:02:10.19,0:02:11.84,Sub,,0,0,0,,tính ngược lại từ\Nđúng cái ngày bạn quẹt
Dialogue: 0,0:02:11.84,0:02:13.79,Sub,,0,0,0,,Mức lãi đó còn cao hơn\Ncả vay tiêu dùng thông thường
Dialogue: 0,0:02:13.79,0:02:14.67,Sub,,0,0,0,,Cái mác miễn lãi
Dialogue: 0,0:02:14.67,0:02:15.97,Sub,,0,0,0,,hóa ra có một\Nđiều kiện rất chặt
Dialogue: 0,0:02:15.97,0:02:17.69,Sub,,0,0,0,,Và đây là cái\Nbẫy tinh vi nhất
Dialogue: 0,0:02:17.69,0:02:18.83,Sub,,0,0,0,,tên là trả tối thiểu
Dialogue: 0,0:02:18.83,0:02:21.27,Sub,,0,0,0,,Cuối kỳ, ngân hàng chỉ\Nbắt bạn trả một khoản nhỏ
Dialogue: 0,0:02:21.27,0:02:23.32,Sub,,0,0,0,,thường là\Nnăm phần trăm dư nợ
Dialogue: 0,0:02:23.32,0:02:24.20,Sub,,0,0,0,,Nghe rất nhẹ nhàng
Dialogue: 0,0:02:24.20,0:02:25.81,Sub,,0,0,0,,rất tử tế
Dialogue: 0,0:02:25.81,0:02:27.98,Sub,,0,0,0,,Nhưng đó chính\Nlà cái thòng lọng
Dialogue: 0,0:02:27.98,0:02:29.73,Sub,,0,0,0,,Lấy lại ví dụ\Nhai mươi triệu lúc nãy
Dialogue: 0,0:02:29.73,0:02:32.80,Sub,,0,0,0,,Nếu bạn chỉ trả tối\Nthiểu một triệu cho nhẹ túi
Dialogue: 0,0:02:32.80,0:02:34.71,Sub,,0,0,0,,thì mười chín triệu còn\Nlại vẫn bị tính lãi
Dialogue: 0,0:02:34.71,0:02:36.26,Sub,,0,0,0,,Với mức lãi\Nba mươi phần trăm một năm
Dialogue: 0,0:02:36.26,0:02:38.56,Sub,,0,0,0,,riêng tháng đó bạn đã mất\Ngần năm trăm nghìn chỉ tính
Dialogue: 0,0:02:38.56,0:02:40.81,Sub,,0,0,0,,tiền lãi, mà cục nợ\Ngốc thì gần như còn nguyên
Dialogue: 0,0:02:40.81,0:02:41.92,Sub,,0,0,0,,Cứ thế tháng\Nnày nối tháng kia
Dialogue: 0,0:02:41.92,0:02:45.10,Sub,,0,0,0,,bạn nuôi một cục nợ\Ngần như không bao giờ dứt
Dialogue: 0,0:02:45.10,0:02:47.56,Sub,,0,0,0,,Rồi còn chuyện rút tiền\Nmặt từ thẻ tín dụng
Dialogue: 0,0:02:47.56,0:02:49.25,Sub,,0,0,0,,nhiều người tưởng tiện
Dialogue: 0,0:02:49.25,0:02:50.52,Sub,,0,0,0,,Nhưng bạn rút mười triệu
Dialogue: 0,0:02:50.52,0:02:52.11,Sub,,0,0,0,,là lập tức mất\Nbốn trăm nghìn tiền phí
Dialogue: 0,0:02:52.11,0:02:54.34,Sub,,0,0,0,,rồi cõng thêm lãi cao\Ntính ngay từ giây phút đó
Dialogue: 0,0:02:54.34,0:02:56.73,Sub,,0,0,0,,không có lấy một\Nngày miễn lãi nào
Dialogue: 0,0:02:56.73,0:02:58.11,Sub,,0,0,0,,Chưa kể phí thường niên
Dialogue: 0,0:02:58.11,0:02:59.67,Sub,,0,0,0,,nhiều thẻ quảng\Ncáo miễn phí mở
Dialogue: 0,0:02:59.67,0:03:01.80,Sub,,0,0,0,,nhưng nếu cả năm bạn\Nkhông xài đủ chỉ tiêu
Dialogue: 0,0:03:01.80,0:03:03.31,Sub,,0,0,0,,cuối năm vẫn bị trừ\Nvài trăm nghìn tới cả triệu
Dialogue: 0,0:03:03.31,0:03:05.37,Sub,,0,0,0,,Đúng như một\Nbình luận rất thật
Dialogue: 0,0:03:05.37,0:03:07.85,Sub,,0,0,0,,đéo ai cho\Nkhông ai cái gì
Dialogue: 0,0:03:07.85,0:03:09.23,Sub,,0,0,0,,Nhưng cái giá đắt nhất\Nkhông nằm ở tiền lãi
Dialogue: 0,0:03:09.23,0:03:10.95,Sub,,0,0,0,,mà nằm ở\Nhai chữ nợ xấu
Dialogue: 0,0:03:10.95,0:03:13.13,Sub,,0,0,0,,Chỉ cần bạn trễ\Nhạn trả nợ đủ lâu
Dialogue: 0,0:03:13.13,0:03:15.16,Sub,,0,0,0,,cái tên của bạn sẽ bị\Nđánh dấu trên hệ thống C.I.C
Dialogue: 0,0:03:15.16,0:03:16.71,Sub,,0,0,0,,nhảy vào nhóm nợ xấu
Dialogue: 0,0:03:16.71,0:03:18.51,Sub,,0,0,0,,Và vết đen đó\Nkhông xóa ngay được
Dialogue: 0,0:03:18.51,0:03:20.56,Sub,,0,0,0,,nó bám theo hồ sơ\Ncủa bạn nhiều năm trời
Dialogue: 0,0:03:20.56,0:03:23.57,Sub,,0,0,0,,Đến lúc bạn thật\Nsự cần một khoản lớn
Dialogue: 0,0:03:23.57,0:03:25.06,Sub,,0,0,0,,muốn vay mua\Ncăn nhà đầu tiên
Dialogue: 0,0:03:25.06,0:03:26.24,Sub,,0,0,0,,muốn vay mua xe\Nđể chạy dịch vụ
Dialogue: 0,0:03:26.24,0:03:28.83,Sub,,0,0,0,,ngân hàng chỉ cần tra\Nmột cái là lắc đầu
Dialogue: 0,0:03:28.83,0:03:31.90,Sub,,0,0,0,,Chỉ vì vài lần quẹt thẻ\Nmua sắm cho vui rồi quên
Dialogue: 0,0:03:31.90,0:03:34.30,Sub,,0,0,0,,trả đúng hạn, mà giấc mơ\Nan cư có khi phải dời
Dialogue: 0,0:03:34.30,0:03:35.72,Sub,,0,0,0,,lại ba, bốn năm
Dialogue: 0,0:03:35.72,0:03:37.38,Sub,,0,0,0,,Cái tiện nhất thời
Dialogue: 0,0:03:37.38,0:03:39.43,Sub,,0,0,0,,đổi lấy cái mất rất dài
Dialogue: 0,0:03:39.43,0:03:41.27,Sub,,0,0,0,,Nguy hiểm hơn\Ncả những con số
Dialogue: 0,0:03:41.27,0:03:42.30,Sub,,0,0,0,,là cái bẫy trong đầu
Dialogue: 0,0:03:42.30,0:03:43.54,Sub,,0,0,0,,Khi quẹt thẻ, bạn không\Nthấy tiền rời khỏi ví
Dialogue: 0,0:03:43.54,0:03:44.78,Sub,,0,0,0,,cảm giác cứ như tiền chùa
Dialogue: 0,0:03:44.78,0:03:46.68,Sub,,0,0,0,,thế là tiêu\Nvung tay quá trán
Dialogue: 0,0:03:46.68,0:03:48.89,Sub,,0,0,0,,Đến cuối kỳ nhận\Nsao kê mới giật mình
Dialogue: 0,0:03:48.89,0:03:50.33,Sub,,0,0,0,,Nhiều người vì thế\Nmà sống nơm nớp
Dialogue: 0,0:03:50.33,0:03:53.44,Sub,,0,0,0,,cả tháng chỉ lo canh\Ncho đúng ngày trả nợ
Dialogue: 0,0:03:53.44,0:03:56.25,Sub,,0,0,0,,Vậy làm sao để tấm thẻ\Nnày là đòn bẩy chứ không
Dialogue: 0,0:03:56.25,0:03:57.10,Sub,,0,0,0,,phải cái bẫy?
Dialogue: 0,0:03:57.10,0:03:58.78,Sub,,0,0,0,,Có mấy nguyên tắc vàng
Dialogue: 0,0:03:58.78,0:03:59.63,Sub,,0,0,0,,ghi nhớ kỹ
Dialogue: 0,0:03:59.63,0:04:00.95,Sub,,0,0,0,,Thứ nhất, và quan trọng nhất
Dialogue: 0,0:04:00.95,0:04:04.36,Sub,,0,0,0,,chỉ quẹt đúng số tiền mà bạn\Nđang thực sự có trong tài khoản
Dialogue: 0,0:04:04.36,0:04:05.84,Sub,,0,0,0,,Hãy coi thẻ tín dụng như\Nmột thẻ ghi nợ trả sau
Dialogue: 0,0:04:05.84,0:04:07.85,Sub,,0,0,0,,tuyệt đối đừng tiêu vào\Nkhoản tiền bạn chưa kiếm được
Dialogue: 0,0:04:07.85,0:04:08.70,Sub,,0,0,0,,Thứ hai, luôn trả\Ntoàn bộ dư nợ
Dialogue: 0,0:04:08.70,0:04:11.36,Sub,,0,0,0,,đúng hạn, và hãy bật chế\Nđộ trích nợ tự động để
Dialogue: 0,0:04:11.36,0:04:13.16,Sub,,0,0,0,,không bao giờ quên
Dialogue: 0,0:04:13.16,0:04:14.14,Sub,,0,0,0,,Đừng bao giờ, nhắc lại
Dialogue: 0,0:04:14.14,0:04:16.13,Sub,,0,0,0,,đừng bao giờ dừng\Nở mức trả tối thiểu
Dialogue: 0,0:04:16.13,0:04:18.15,Sub,,0,0,0,,Thứ ba, tuyệt đối không rút\Ntiền mặt từ thẻ tín dụng
Dialogue: 0,0:04:18.15,0:04:20.37,Sub,,0,0,0,,Thứ tư, để ý điều\Nkiện miễn phí thường niên
Dialogue: 0,0:04:20.37,0:04:22.18,Sub,,0,0,0,,và đừng quẹt quá một nửa hạn\Nmức để giữ điểm tín dụng đẹp
Dialogue: 0,0:04:22.18,0:04:24.38,Sub,,0,0,0,,Và cuối cùng, thành\Nthật với chính mình
Dialogue: 0,0:04:24.38,0:04:26.25,Sub,,0,0,0,,nếu bạn là người hay quên
Dialogue: 0,0:04:26.25,0:04:28.37,Sub,,0,0,0,,hay bốc đồng, dễ vung\Ntay khi thấy còn hạn mức
Dialogue: 0,0:04:28.37,0:04:29.71,Sub,,0,0,0,,thì tốt nhất cứ dùng\Nthẻ ghi nợ cho lành
Dialogue: 0,0:04:29.71,0:04:31.44,Sub,,0,0,0,,tiêu bằng tiền thật\Ncủa mình cho nó chắc
Dialogue: 0,0:04:31.44,0:04:34.05,Sub,,0,0,0,,Bạn thấy không, tấm thẻ tín dụng\Nthật ra chẳng tốt cũng chẳng xấu
Dialogue: 0,0:04:34.05,0:04:35.28,Sub,,0,0,0,,Nó chỉ là một\Ncông cụ trung tính
Dialogue: 0,0:04:35.28,0:04:36.41,Sub,,0,0,0,,giống như một con dao
Dialogue: 0,0:04:36.41,0:04:37.42,Sub,,0,0,0,,Trong tay người đầu bếp giỏi
Dialogue: 0,0:04:37.42,0:04:38.42,Sub,,0,0,0,,nó làm ra món ngon
Dialogue: 0,0:04:38.42,0:04:39.75,Sub,,0,0,0,,Trong tay người hấp tấp
Dialogue: 0,0:04:39.75,0:04:41.25,Sub,,0,0,0,,nó cứa đứt tay
Dialogue: 0,0:04:41.25,0:04:43.48,Sub,,0,0,0,,Cái câu người giàu quẹt\Ntín dụng mà không mắc nợ
Dialogue: 0,0:04:43.48,0:04:44.66,Sub,,0,0,0,,sự thật không\Nphải vì họ giàu
Dialogue: 0,0:04:44.66,0:04:45.62,Sub,,0,0,0,,mà vì họ kỷ luật
Dialogue: 0,0:04:45.62,0:04:46.58,Sub,,0,0,0,,chỉ tiêu trong khả năng
Dialogue: 0,0:04:46.58,0:04:48.53,Sub,,0,0,0,,và luôn trả đúng hạn
Dialogue: 0,0:04:48.53,0:04:50.30,Sub,,0,0,0,,Thế nên câu hỏi thật sự\Nkhông phải là thẻ ghi nợ
Dialogue: 0,0:04:50.30,0:04:51.42,Sub,,0,0,0,,hay thẻ tín dụng\Ncái nào tốt hơn
Dialogue: 0,0:04:51.42,0:04:53.63,Sub,,0,0,0,,mà là: bạn\Nlà kiểu người nào?
Dialogue: 0,0:04:53.63,0:04:54.51,Sub,,0,0,0,,Trả lời được câu đó
Dialogue: 0,0:04:54.51,0:04:56.64,Sub,,0,0,0,,bạn sẽ tự biết mình\Nnên cầm tấm thẻ nào
Dialogue: 0,0:04:56.64,0:04:57.77,Sub,,0,0,0,,Nếu clip này giúp bạn nhìn\Nrõ hơn về tấm thẻ trong
Dialogue: 0,0:04:57.77,0:04:58.95,Sub,,0,0,0,,ví, hãy theo dõi Anh Hai
Dialogue: 0,0:04:58.95,0:05:00.92,Sub,,0,0,0,,để mình cùng nhau nhìn thẳng\Nvào những bài toán tiền bạc
Dialogue: 0,0:05:00.92,0:05:01.77,Sub,,0,0,0,,của đời người
Dialogue: 0,0:05:01.77,0:05:02.75,Sub,,0,0,0,,Và nhớ, giữ vững tinh thần
Dialogue: 0,0:05:02.75,0:05:04.08,Sub,,0,0,0,,giữ ví cho chặt nhé